// { ini key, section, label, format, help, choice names separated by '|' }

    { "Quality", "Quality", "Quality", "", "Resolution and ray-march steps of the fog pass", "Low: quarter resolution, 16 steps|Medium: half resolution, 24 steps|High: half resolution, 32 steps" },
    { "Temporal", "Quality", "Temporal filter", "%.2f", "History weight of the temporal filter, 0 = off", "" },
    { "Density", "Density", "Density", "%.2f", "Global density multiplier", "" },
    { "FogCeiling", "Density", "Fog ceiling", "%.0f yd", "While you fly or stand well above the ground, the fog keeps to this many yards over the ground (fading over half as much again), so it lies in valleys and among the trees and the air above it is clear; the sunlit air still shows the shafts. It comes in as the camera rises from 1.5 to 3 times this height over the ground under it, so nothing changes on foot. 0 = off", "" },
    { "Haze", "Density", "Haze", "%.2f", "Distance haze where no Classic data exists", "" },
    { "GroundFog", "Density", "Ground fog", "%.2f", "Low ground mist where no Classic data exists", "" },
    { "FarFog", "Density", "Distance fog", "%.2f", "The distance fog that replaces the stock fog", "" },
    { "FarFogStretch", "Density", "Fog follows the view", "%.2f", "1: with the view distance lifted past the client's cap, the distance fog reaches as much further as the view does, so land past the zone's fog end is not drawn as a flat fog-coloured shape. 0: the fog ends at the zone's fog distance in yards", "" },
    { "AerialPerspective", "Density", "Aerial perspective", "%.2f", "1: distant land fades into the zone's own fog colour, the sky at the horizon, and the sun brightens the haze only around itself. 0: the haze is lit by the sun from every side, which turns distant mountains pale", "" },
    { "StockFog", "Density", "Replace the stock fog", "", "On: the volumetric distance fog replaces the client's linear fog. Off: keep the stock fog", "" },
    { "DataMode", "Density", "Classic fog layers", "", "Use the Classic client's fog layers where its lights cover the map. Off: derived layers everywhere", "" },
    { "MaxDistance", "Density", "Fog range", "%.0f yd", "How far sky rays are integrated and the scale of the Classic distance curves", "" },
    { "SunScatter", "Light", "Sun scatter", "%.2f", "In-scattered sun or moon light: the halo and the shafts", "" },
    { "Ambient", "Light", "Ambient", "%.2f", "Ambient fog brightness", "" },
    { "Exposure", "Light", "Exposure", "%.2f", "Brightness of the layers used where no Classic data exists", "" },
    { "ClassicExposure", "Light", "Classic exposure", "%.2f", "Brightness of the Classic layers, 1 = as authored", "" },
    { "ColorSpace", "Light", "Linear light", "", "Scatter and blend in linear light like the modern client, with a soft highlight roll-off. Off: gamma", "" },
    { "LightShafts", "Light", "Light shafts", "", "Shadowed in-scattering: light shafts through trees, buildings and terrain", "" },
    { "TerrainShadows", "Light", "Terrain shadows", "", "Mountains and buildings around you keep the sun and moon out of the fog in their shadow, whether or not they are on screen", "" },
    { "SurfaceShadows", "Light", "Surface shadows", "%.2f", "Shadows of mountains and buildings on the ground, walls and characters, from the same height map, whether or not the mountain is on screen. 1 = the sun's whole share of the light is taken away, 0 = off", "" },
    { "LowSunLight", "Light", "Low sun light", "%.2f", "While the sun is low, slopes and walls facing it, where it reaches, get a warm lift in its colour, so the light lands on the far mountains at dawn and dusk. 1 = 35% brighter, 0 = off", "" },
    { "GodRays", "Light", "God rays", "%.2f", "Radial rays from the bright sky around the sun, 0 = off", "" },
    { "GlowCompensation", "Light", "Glow compensation", "", "Pre-compensate the fog for the client's full-screen glow, which otherwise bleaches bright fog around the sun to white", "" },
    { "LightSaturation", "Colour", "Light saturation", "%.2f", "Colour of the sun's or moon's light in the fog, the shafts and the haze, at the same brightness: 1 = the client's, 0 = white. The sky-lit part of the fog keeps its colour", "" },
    { "HazeSaturation", "Colour", "Haze saturation", "%.2f", "Colour of the sky-lit part of the fog and the haze, the zone's fog colour, at the same brightness: 1 = the client's, 0 = grey, 2 = twice as strong", "" },
    { "Saturation", "Colour", "Saturation", "%.2f", "Colour of the whole picture at the same brightness: 1 = unchanged, 0 = grey (needs Linear light)", "" },
    { "SkySaturation", "Colour", "Sky saturation", "%.2f", "Colour of the sky alone, on top of Saturation: 1 = as the rest of the picture, 0 = grey", "" },
    { "Temperature", "Colour", "Temperature", "%.2f", "White balance of the whole picture at the same brightness: above 0 warmer (amber), below 0 cooler (blue); 1 = red twice blue (needs Linear light)", "" },
    { "Tint", "Colour", "Tint", "%.2f", "White balance of the whole picture at the same brightness: above 0 toward magenta, below 0 toward green (needs Linear light)", "" },
    { "SkyTemperature", "Colour", "Sky temperature", "%.2f", "Temperature of the sky alone, on top of Temperature: 0 = as the rest of the picture", "" },
    { "SkyTint", "Colour", "Sky tint", "%.2f", "Tint of the sky alone, on top of Tint: 0 = as the rest of the picture", "" },
    { "LightBalance", "Colour", "Light balance", "%.2f", "White balance of the land and everything on it against the client's sun and ambient light: 0 = the client's colour, 1 = a neutral light at the same brightness, 2 = past it. Not the sky, not indoors (needs Linear light)", "" },
    { "LandBrightness", "Colour", "Land brightness", "%.2f", "Brightness of the land and everything on it, not the sky: 1 = the client's (needs Linear light)", "" },
    { "SkyBrightness", "Colour", "Sky brightness", "%.2f", "Brightness of the sky alone, in linear light: 1 = the client's, 2 = twice as bright (needs Linear light)", "" },
    { "SkyHaze", "Colour", "Sky haze", "%.2f", "Share of the clear sky behind a haze in the horizon's colour, as rain covers it with Overcast sky: 0 = the client's sky, 1 = all haze", "" },
    { "SkyHazeGlow", "Colour", "Sun in the haze", "%.2f", "Brightness of the sun's disc and its halo in the sky haze, in the sun's colour", "" },
    { "SkyHazeZenith", "Colour", "Haze overhead", "%.2f", "Brightness of the sky haze straight overhead against the horizon, in linear light: 1 = even, 0.1 = a bright band at the horizon under a dark sky", "" },
    { "SkyHazeGlowGrade", "Colour", "Sun takes the sky's colour", "%.2f", "How much of the sky's own colour, brightness and saturation the sun's glow in the haze takes: 1 = all of it, 0 = it keeps the sun's colour under a sky turned cool or grey", "" },
    { "HazeFromSky", "Colour", "Haze takes the sky's colour", "%.2f", "How far the haze's sky-lit light in front of the land takes the colour of the sky at the horizon, as drawn: 1 = all the way (a bright sky gives bright distant hills, a dark one dark ones), 0 = the haze's own colour. The sky and the sun's light in the haze are unchanged", "" },
    { "HazeSkyLevel", "Colour", "Haze against the sky", "%.2f", "The brightness of that haze against the sky at the horizon, as displayed: 0.85 = a bit darker, 1 = as bright. Land seen through the haze keeps some of its own light, so snow can still stand out brighter than the sky", "" },
    { "Shafts", "Sun and moon shafts", "Shafts", "%.2f", "Extra sunlight scattered in the fog and the air wherever the sun reaches, traced through trees, buildings and terrain whether or not the sun is on screen. 0 = only the fog's own shadowed light", "" },
    { "ShaftFocus", "Sun and moon shafts", "Focus", "%.2f", "0 = shafts as bright from every side; higher = brighter looking toward the sun, fainter looking away", "" },
    { "LowSunShafts", "Sun and moon shafts", "Low sun", "%.2f", "Stronger shafts while the sun is low: 1 = twice as strong at dawn and dusk, fading out by 30 degrees up; 0 = the same all day", "" },
    { "ShaftGlare", "Sun and moon shafts", "Sun glare", "%.2f", "How bright the shafts' light grows before it grows only slowly: lower keeps the glow around a low sun small while beams through trees and gaps keep their strength; 4 = almost no limit", "" },
    { "MoonShafts", "Sun and moon shafts", "Moon shafts", "%.2f", "The same beams from the moon at night. Moonlight is dim and the moon stands high, so they need more strength than the sun's. 0 = only the fog's own shadowed light", "" },
    { "MoonShaftFocus", "Sun and moon shafts", "Moon focus", "%.2f", "Focus of the moon's shafts. The moon stands high, so a low focus keeps them visible when looking level", "" },
    { "ShaftHaze", "Sun and moon shafts", "Clear air", "%.2f", "Air lit by the shafts, so they show where the fog is thin", "" },
    { "ShaftRange", "Sun and moon shafts", "Range", "%.0f yd", "How far from the camera shafts are traced", "" },
    { "ShaftMemory", "Sun and moon shafts", "Remember what was seen", "", "Trees and buildings shade the shafts from a shadow map, seen from the sun, of everything the camera has seen so far. It stays fixed in the world, so turning the camera does not change the shafts, and gaps between leaves stay open. Off = only what is on screen, with a guess past its edges", "" },
    { "ShaftLength", "Sun and moon shafts", "Length", "%.0f yd", "How far toward the sun each point looks for trees and buildings that shade it (only without the memory, which looks all the way)", "" },
    { "ShaftDepth", "Sun and moon shafts", "Occluder depth", "%.2f", "How deep trees and buildings are taken to be behind their visible face, per yard of their distance (only without the memory)", "" },
    { "Drift", "Drift and mist", "Drift", "%.2f", "How patchy the fog is. The patches drift with the wind and the shafts brighten in the thick ones. 0 = even fog, as before", "" },
    { "DriftSize", "Drift and mist", "Patch size", "%.0f yd", "Size of the drifting fog patches", "" },
    { "DriftDetail", "Drift and mist", "Smoke", "%.2f", "Share of fine, wispy smoke in the drift, a tenth of the patch size and smaller. 0 = only the large patches", "" },
    { "DriftSwirl", "Drift and mist", "Swirl", "%.2f", "How far the large patches twist and stretch the smoke. 0 = straight wisps", "" },
    { "Banks", "Drift and mist", "Fog banks", "", "Gathers the fog into separate banks, as big as the patches, that lie on the ground, fill valleys and leave clear air between them, instead of even layers at your own height", "Off: even layers|Everywhere, all day|Valleys and water at dawn and dusk" },
    { "BankCover", "Drift and mist", "Bank cover", "%.2f", "Share of the ground under a fog bank; the banks are denser where they are fewer, so the fog as a whole keeps its amount. 1 = one even blanket", "" },
    { "BankHeight", "Drift and mist", "Bank height", "%.0f yd", "How high the banks reach above the ground under them", "" },
    { "BankPool", "Drift and mist", "Valleys", "%.2f", "How much the fog gathers in valleys and over lakes and leaves ridges and hilltops clear. 0 = the same on every slope", "" },
    { "BankShadow", "Drift and mist", "Bank shade", "%.2f", "How much a bank shades its own inside from the sun or moon, so it has a lit side and a dark one", "" },
    { "WindSpeed", "Drift and mist", "Wind", "%.1f yd/s", "Drift speed in clear weather", "" },
    { "StormWind", "Drift and mist", "Storm wind", "%.1f yd/s", "Drift speed in full rain, snow or sandstorm; weaker weather lies in between", "" },
    { "WindDirection", "Drift and mist", "Wind direction", "%.0f deg", "Where the wind blows to: 0 north, 90 east, 180 south, 270 west", "" },
    { "MorningMist", "Drift and mist", "Morning mist", "%.2f", "Extra fog in low ground at dawn (full 05:00 to 07:30, gone by 10:00). 2 = three times the fog near the ground; zones with little fog of their own get up to eight times more", "" },
    { "MistHeight", "Drift and mist", "Mist height", "%.0f yd", "How far above your ground level the morning mist reaches", "" },
    { "EveningHaze", "Drift and mist", "Evening haze", "%.2f", "Extra fog everywhere in the evening (full 20:00 to 22:00, gone by midnight)", "" },
    { "WeatherFog", "Weather", "Weather fog", "%.2f", "Extra fog in full rain, snow or sandstorm. 1 = twice the fog", "" },
    { "WeatherShafts", "Weather", "Weather shafts", "%.2f", "Share of the shafts left in full weather, as clouds hide the sun", "" },
    { "WeatherTint", "Weather", "Weather tint", "%.2f", "Fog turns grey in rain, white in snow and sandy in a sandstorm", "" },
    { "WeatherSky", "Weather", "Weather sky", "%.2f", "The sky and its clouds turn the colour of the weather's fog, overcast. 1 = 85% in full weather", "" },
    { "RainInFront", "Weather", "Rain in front", "%.2f", "Rain, snow and sand stay in front of the fog and the overcast sky, as near as they fall: 1 = fogged as if 25 yd away, 0 = as if as far as what is behind them", "" },
    { "DustHaze", "Open land", "Dust haze", "%.2f", "Warm, sunlit dust in the air of dry zones, thickest in the afternoon and in wind. 0 = off", "" },
    { "HumidHaze", "Open land", "Humid haze", "%.2f", "A soft, cool haze over green open land, thickest in the morning. 0 = off", "" },
    { "HorizonFog", "Open land", "Horizon fog", "%.2f", "In dry and green zones, far land fades gradually into the colour of the sky at the horizon. 0 = the zone's own distance fog", "" },
    { "CloudShadows", "Open land", "Cloud shadows", "%.2f", "Shadows of clouds drifting with the wind over dry and green zones, on the ground and in the haze; with a low sun they give beams between the clouds. 1 = a cloud takes the sun's whole share of the light away, 0 = off", "" },
    { "CloudCover", "Open land", "Cloud cover", "%.2f", "How much of the sky the clouds cover: 1 = about a quarter in dry zones and nearly half in green ones, at most 90%", "" },
    { "CloudSize", "Open land", "Cloud size", "%.0f yd", "How wide one cloud is, in yards", "" },
    { "Twilight", "Dusk and night", "Twilight", "%.2f", "Blue tint of the fog around sunset and sunrise, while the sun is just below the horizon and the moon is not up", "" },
    { "SkyboxMoons", "Dusk and night", "Skybox moons", "", "Draw the moons the HD skyboxes paint on their sky. Off = only the game's own moon shows, the one the moonlight, the moon shafts and the glitter on the water come from", "" },
    { "SunAndMoon", "Dusk and night", "Sun and moon over the sky", "%.2f", "The game's own sun and moon drawn over the sky last, so an HD skybox or the sky haze cannot hide them; land in front still does. 1 = as the client draws them, dimmer in thick fog and rain; 0 = left to the client, under the skybox and the haze", "" },
    { "LightGlow", "Dusk and night", "Light glow", "%.2f", "Lamps, windows and fires glow into the fog at night; the thicker the fog, the larger the halo. 0 = off", "" },
    { "GlowThreshold", "Dusk and night", "Glow threshold", "%.2f", "How bright a pixel must be to glow; lower = more things glow", "" },
    { "LampFog", "Dusk and night", "Lamp halos", "%.2f", "Torches, candles, braziers and lanterns placed in the world glow in the air, more in rain, snow or sand; by day the By day share of it; none in the ghost world. Needs lampdata.bin. 0 = off", "" },
    { "LampCount", "Dusk and night", "Lamps", "%d", "How many lamps in view glow and light things, brightest first. Lamps reach 800 yd and fade from 650 yd; while halos or far lights show, up to 64 more lamps beyond 80 yd glow without lighting things", "" },
    { "LampFlicker", "Dusk and night", "Flicker", "%.2f", "How much flames flicker; lanterns behind glass stay steady. 0 = steady", "" },
    { "FireStrength", "Dusk and night", "Fires", "%.2f", "Strength of open fires (braziers, bonfires, campfires and hearths), their light and halos, against the other lamps. 1 = as the other lamps", "" },
    { "FarLights", "Dusk and night", "Far lights", "%.2f", "At night the lamps of towns and camps from 60 yd out show as small points of light, even where their halos are too faint to see, so a town across a valley isn't dark. Hidden lamps show none. 0 = off", "" },
    { "LampIndoors", "Dusk and night", "Indoors", "%.2f", "Strength of lamps inside rooms (inns, houses, halls), and of every lamp while you stand indoors, their light and halos. 1 = as outdoors", "" },
    { "LampLight", "Dusk and night", "Lamp light", "%.2f", "The same lamps light the ground, walls, plants and characters around them in their own colour, falling off like the game's own lights; by day too, most in shade; none in the ghost world. 0 = off", "" },
    { "LampDayLight", "Dusk and night", "By day", "%.2f", "Share of the lamps' light and halos by day, when the sun outshines them. 0 = none by day, 1 = as at night", "" },
    { "WindowLight", "Dusk and night", "Window light", "%.2f", "Lit windows cast their light onto the street, walls and characters in front of them, up to 8 windows at a time; none by day and none in the ghost world. 0 = off", "" },
    { "EffectLight", "Dusk and night", "Spell light", "%.2f", "Glowing spells, projectiles, enchants and other bright effects on screen light the ground, walls and characters around them in their own colour, up to 6 at a time; the placed lamps' own flames are left to the lamps. In rain or snow only coloured glows count. By day the lamps' By day share; none in the ghost world. 0 = off", "" },
    { "CorpseLight", "Dusk and night", "Loot sparkle", "%.2f", "Corpses you can loot give a small golden twinkle of light, the nearest 4 within 40 yd, from the client's own list of what is lootable. By day the lamps' By day share; none in the ghost world. 0 = off", "" },
    { "LampShadows", "Dusk and night", "Lamp shadows", "%.2f", "Things on screen between a lamp and a surface block its light. 0 = no lamp shadows", "" },
    { "CarriedShadows", "Dusk and night", "Carried light shadows", "%.2f", "How much of the lamp shadows the lights that move with things keep: spells, projectiles, enchants, the loot sparkle and the belt lantern. 0 = they cast no shadows, so no character's shadow swings around with them; placed lamps keep theirs", "" },
    { "NightDarkness", "Dusk and night", "Night darkness", "%.2f", "Darkens the moonlit scene at night outdoors, but not flames, lit windows, lit interiors or what the lamps light, and not while you are indoors. 0 = the game's own night", "" },
    { "Lantern", "Belt lantern", "Lantern", "", "A lantern at your belt lights the ground, walls, plants and characters around you, and what stands in its light casts shadows. In the dark it lights by itself at night and indoors (caves, dungeons, buildings) and goes out by day; never while swimming or as a ghost", "Off|In the dark|Always" },
    { "LanternLight", "Belt lantern", "Lantern light", "%.2f", "How brightly the lantern lights things around you. 0 = no lantern", "" },
    { "LanternHalo", "Belt lantern", "Lantern halo", "%.2f", "How strongly the lantern glows in the fog around it, on top of Lamp halos. 0 = no glow", "" },
    { "LanternSwing", "Belt lantern", "Swing", "%.2f", "How much the lantern swings on its hook as you walk, run, turn and stop. 0 = it hangs still", "" },
    { "Relief", "Ground relief", "Relief", "", "Paved roads, tiles, stones and rock on the ground get depth: they shift with the view (parallax occlusion), catch the light on their sunlit side and shade themselves. Needs reliefdata.bin and exterior shadows 3-5 (extShadowQuality)", "" },
    { "ReliefModels", "Ground relief", "On models", "", "Trees, creatures, characters, armour and props get relief too. Their height maps are made while you play, on a thread of their own, the first time each texture is drawn", "" },
    { "ReliefDepth", "Ground relief", "Depth", "%.3f yd", "How deep the relief is at its deepest, for stone and paving; each texture type gets its share of it (Relief by texture type)", "" },
    { "ReliefLight", "Ground relief", "Light", "%.2f", "How strongly the relief shapes the light (its sunlit and shaded sides). 0 = depth only", "" },
    { "ReliefShadows", "Ground relief", "Self shadows", "%.2f", "How dark the shadows are that stones and ridges cast onto their own texture", "" },
    { "ReliefDistance", "Ground relief", "Distance", "%.0f yd", "Relief is drawn up to this distance and fades out over its last quarter", "" },
    { "WaterReflect", "Water", "Reflections", "%.2f", "Water mirrors the sky, shores, trees and buildings on screen; strong when you look across the water, weak when you look down into it. 0 = off", "" },
    { "WaterGlitter", "Water", "Glitter", "%.2f", "Sparkling path of the sun, and of the moon at night, on the waves; less under clouds and none in the ghost world. 0 = off", "" },
    { "WaterClarity", "Water", "Clarity", "%.2f", "See the bottom through shallow water, and a deeper teal where the water gets deep. 0 = the game's own water colour", "" },
    { "WaterWaves", "Water", "Waves", "%.2f", "Small waves that break up the reflections and the glitter; higher in rain, snow or sand. 0 = a still mirror", "" },
    { "WaterRain", "Water", "Rain rings", "%.2f", "How strongly raindrops ring out on the water while it rains; how many follows the rain. None in snow or sand. Far away they roughen the water instead. 0 = off", "" },
    { "WaterMemory", "Water", "Remember what was seen", "", "Reflections of what left the screen come from a panorama of everything seen from here, so turning the camera does not make them pop or vanish. Off = only what is on screen", "" },
    { "SurfaceSheen", "Wet and shiny surfaces", "Sheen", "%.2f", "Stone, cobbles, rock, ice and other smooth surfaces catch the sun, the moon and the lamps when you look along them toward the light, most of all under a low sun; snow sparkles; grass, dirt and sand stay matt. 0 = off", "" },
    { "WetSurfaces", "Wet and shiny surfaces", "Wet in rain", "%.2f", "Rain wets what stands under the open sky within about a minute, each ground as its material takes water: stone gets a glossy film at once, soil and sand darken first, grass beads into droplets that glint but never mirror, snow does not darken. It dries over minutes once the rain stops, slower at night. Nothing under roofs. 0 = never wet", "" },
    { "Puddles", "Wet and shiny surfaces", "Puddles", "%.2f", "How much of the flat open ground pools into puddles in steady rain: still mirrors that fill over a minute or two and outlast the wet ground. Never on grass or snow. 0 = no puddles", "" },
    { "TerrainMaterials", "Wet and shiny surfaces", "Ground materials from textures", "", "Tell the ground's material from its texture (materialdata.bin): grass, soil, stone, sand, snow, ice, wood or lava. Off = judge every surface by its colour. Needs extShadowQuality 3+", "" },
    { "FarClipMax", "Wet and shiny surfaces", "View distance", "%.0f yd", "Continent view distance, within the client's own farclip setting", "" },
    { "Underwater", "World", "Fog under water", "", "Keep the effect while the camera is under water", "" },
    { "LiquidDepth", "World", "Water writes depth", "", "Let water surfaces write depth so water is fogged by its own distance", "" },
    { "DebugView", "Debug", "View", "", "Show one input of the fog instead of the scene", "Off|Fog radiance|Transmittance|Linear depth|Surface shadows|Lamp halos|Lamp light on surfaces|Client shadow maps (receiver matrices)|Client shadow maps (caster matrices)" },
    { "SunMarker", "Debug", "Sun marker", "", "Red marker where the sun direction projects on screen", "" },
    { "ClientShadowMaps", "Debug", "Client shadow maps", "", "Find the client's own sun shadow maps each frame and describe them in CoAVolFog.log", "" },
