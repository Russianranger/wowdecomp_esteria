int GetVertexSize(uint32 flags)
{
    local int size = 0;
    local int lookup_pairs = 0;

    if (flags & 0x00000001) size += 12;
    if (flags & 0x00000020) lookup_pairs += 2;
    if (flags & 0x00000040) lookup_pairs += 2;
    size += lookup_pairs * 2;
    if (flags & 0x00000080) size += 12;
    if (flags & 0x00800000) size += 4;
    if (flags & 0x00000100) size += 4;
    if (flags & 0x00000200) size += 4;
    if (flags & 0x00000400) size += 4;
    if (flags & 0x00000800) size += 4;
    if (flags & 0x00001000) size += 4;
    if (flags & 0x00002000) size += 8;
    if (flags & 0x00004000) size += 8;
    if (flags & 0x00008000) size += 8;
    if (flags & 0x00010000) size += 8;
    if (flags & 0x00020000) size += 4;
    if (flags & 0x00040000) size += 4;
    if (flags & 0x00080000) size += 4;
    if (flags & 0x00100000) size += 4;
    if (flags & 0x40000000) size += 4;
    if (flags & 0x00200000) size += 12;
    if (flags & 0x00400000) size += 12;
    if (flags & 0x01000000) size += 4;
    if (flags & 0x02000000) size += 4;
    if (flags & 0x04000000) size += 12;
    if (flags & 0x08000000) size += 12;
    if (flags & 0x10000000) size += 4;
    if (flags & 0x20000000) size += 4;
    return size;
}

quad GetSectionEnd(Tag &t)
{
    local quad result = m3_file_size;
    local uint other_offset;
    local int k;

    if (m3_index_offset > t.ofs && m3_index_offset < result)
        result = m3_index_offset;

    for (k = 0; k < m3_tag_count; k++)
    {
        other_offset = ReadUInt(m3_index_offset + (k * tag_size) + 4);
        if (other_offset > t.ofs && other_offset < result)
            result = other_offset;
    }
    return result;
}

int GetKnownEntrySize(Tag &t)
{
    local uint version = t.vers;
    switch (t.blockID)
    {
        case "RAHC": if (version == 0) return 1; break; // CHAR
        case "GALF": if (version == 0) return 4; break; // FLAG
        case "__8U": if (version == 0) return 1; break; // U8__
        case "_61I": if (version == 0) return 2; break; // I16_
        case "_61U": if (version == 0) return 2; break; // U16_
        case "_23I": if (version == 0) return 4; break; // I32_
        case "_23U": if (version == 0) return 4; break; // U32_
        case "_46U": if (version == 0) return 8; break; // U64_
        case "LAER": if (version == 0) return 4; break; // REAL
        case "2CEV": if (version == 0) return 8; break; // VEC2
        case "3CEV": if (version == 0) return 12; break; // VEC3
        case "4CEV": if (version == 0) return 16; break; // VEC4
        case "TAUQ": if (version == 0) return 16; break; // QUAT
        case "SDNB": if (version == 0) return 28; break; // BNDS
        case "TNVE": // EVNT
            switch (version) { case 0: return 100; case 1: return 104; case 2: return 108; }
            break;
        case "RHCS": if (version == 0) return 12; break; // SCHR
        case "23RS": if (version == 0) return 20; break; // SR32
        case "3CVS": if (version == 0) return 36; break; // SVC3
        case "VEDS": if (version == 0) return 32; break; // SDEV
        case "V2DS": if (version == 0) return 32; break; // SD2V
        case "V3DS": if (version == 0) return 32; break; // SD3V
        case "3RDS": if (version == 0) return 32; break; // SDR3
        case "CCDS": if (version == 0) return 32; break; // SDCC
        case "8UDS": if (version == 0) return 32; break; // SDU8
        case "6SDS": if (version == 0) return 32; break; // SDS6
        case "3SDS": if (version == 0) return 32; break; // SDS3
        case "6UDS": if (version == 0) return 32; break; // SDU6
        case "3UDS": if (version == 0) return 32; break; // SDU3
        case "Q4DS": if (version == 0) return 32; break; // SD4Q
        case "GFDS": if (version == 0) return 32; break; // SDFG
        case "BMDS": if (version == 0) return 32; break; // SDMB
        case "_CTS": if (version == 4) return 204; break; // STC_
        case "SQES": // SEQS
            switch (version) { case 1: return 96; case 2: return 92; }
            break;
        case "_GTS": if (version == 0) return 24; break; // STG_
        case "TESB": if (version == 0) return 32; break; // BSET
        case "_STS": if (version == 0) return 28; break; // STS_
        case "ENOB": if (version == 1) return 160; break; // BONE
        case "FERI": if (version == 0) return 64; break; // IREF
        case "NGER": // REGN
            switch (version) { case 2: return 28; case 3: return 36; case 4: return 40; case 5: return 48; }
            break;
        case "_TAB": if (version == 1) return 14; break; // BAT_
        case "CESM": if (version == 1) return 72; break; // MSEC
        case "_VID": if (version == 2) return 52; break; // DIV_
        case "_TTA": if (version == 1) return 20; break; // ATT_
        case "ETIL": if (version == 7) return 212; break; // LITE
        case "UTAP": // PATU
            switch (version) { case 1: return 100; case 4: return 152; }
            break;
        case "DGRT": if (version == 0) return 24; break; // TRGD
        case "NMMD": // DMMN
            switch (version) { case 0: return 12; case 1: return 8; }
            break;
        case "TMMD": if (version == 0) return 28; break; // DMMT
        case "EMMD": if (version == 0) return 20; break; // DMME
        case "61TM": if (version == 0) return 14; break; // MT16
        case "23TM": if (version == 0) return 28; break; // MT32
        case "RYAL": // LAYR
            switch (version) { case 20: return 356; case 21: return 356; case 22: return 356; case 23: return 428; case 24: return 436; case 25: return 468; case 26: return 464; }
            break;
        case "MTAM": if (version == 0) return 8; break; // MATM
        case "_TAM": // MAT_
            switch (version) { case 15: return 268; case 16: return 280; case 17: return 280; case 18: return 280; case 19: return 340; case 20: return 352; }
            break;
        case "_SID": if (version == 4) return 68; break; // DIS_
        case "_SMC": if (version == 0) return 24; break; // CMS_
        case "_PMC": if (version == 2) return 28; break; // CMP_
        case "_RET": // TER_
            switch (version) { case 0: return 24; case 1: return 28; }
            break;
        case "_LOV": if (version == 0) return 84; break; // VOL_
        case "_IAH": if (version == 0) return 116; break; // HAI_
        case "_NOV": if (version == 0) return 268; break; // VON_
        case "PERC": // CREP
            switch (version) { case 0: return 24; case 1: return 28; }
            break;
        case "MBTS": if (version == 0) return 48; break; // STBM
        case "BSFL": if (version == 2) return 56; break; // LFSB
        case "RLFL": // LFLR
            switch (version) { case 2: return 80; case 3: return 152; }
            break;
        case "_FER": // REF_
            switch (version) { case 1: return 84; case 2: return 156; case 3: return 160; }
            break;
        case "_RAP": // PAR_
            switch (version) { case 10: return 1300; case 11: return 1304; case 12: return 1316; case 14: return 1356; case 17: return 1460; case 18: return 1464; case 19: return 1464; case 21: return 1464; case 22: return 1484; case 23: return 1492; case 24: return 1496; }
            break;
        case "CRAP": if (version == 0) return 40; break; // PARC
        case "JORP": // PROJ
            switch (version) { case 4: return 388; case 5: return 388; }
            break;
        case "JYHP": if (version == 0) return 180; break; // PHYJ
        case "CCHP": if (version == 0) return 76; break; // PHCC
        case "CAHP": if (version == 0) return 32; break; // PHAC
        case "LCHP": // PHCL
            switch (version) { case 2: return 136; case 4: return 192; }
            break;
        case "_ROF": // FOR_
            switch (version) { case 1: return 104; case 2: return 104; }
            break;
        case "ESMD": if (version == 0) return 4; break; // DMSE
        case "HSHP": // PHSH
            switch (version) { case 1: return 132; case 2: return 292; case 3: return 300; }
            break;
        case "BRHP": // PHRB
            switch (version) { case 2: return 104; case 3: return 56; case 4: return 80; }
            break;
        case "SGSS": if (version == 1) return 108; break; // SSGS
        case "LVTA": if (version == 0) return 116; break; // ATVL
        case "CSBB": if (version == 0) return 48; break; // BBSC
        case "_DMT": if (version == 1) return 72; break; // TMD_
        case "BIRS": if (version == 0) return 272; break; // SRIB
        case "_BIR": // RIB_
            switch (version) { case 4: return 744; case 5: return 748; case 6: return 748; case 8: return 756; case 9: return 760; }
            break;
        case "J2KI": if (version == 0) return 48; break; // IK2J
        case "CCKI": if (version == 0) return 24; break; // IKCC
        case "TJKI": if (version == 0) return 32; break; // IKJT
        case "BOAP": if (version == 0) return 24; break; // PAOB
        case "XBHS": if (version == 0) return 64; break; // SHBX
        case "_MAC": // CAM_
            switch (version) { case 2: return 148; case 3: return 180; case 5: return 264; }
            break;
        case "_PRW": if (version == 1) return 132; break; // WRP_
        case "LOVV": if (version == 0) return 40; break; // VVOL
        case "DDAM": // MADD
            switch (version) { case 1: return 140; case 2: return 152; case 3: return 160; }
            break;
        case "LDOM": // MODL
            switch (version) { case 20: return 748; case 21: return 760; case 23: return 784; case 24: return 796; case 25: return 808; case 26: return 820; case 28: return 844; case 29: return 856; case 30: return 868; }
            break;
        case "43DM": if (version == 11) return 24; break; // MD34
        case "33DM": if (version == 11) return 20; break; // MD33
    }
    return 0;
}

int IsDetailedSection(Tag &t)
{
    switch (t.blockID)
    {
        case "LDOM": return MODL_TYPE == 34;
        case "SQES": return 1;
        case "_CTS": return 1;
        case "_GTS": return 1;
        case "_STS": return 1;
        case "TNVE": return 1;
        case "ENOB": return 1;
        case "FERI": return 1;
        case "NGER": return 1;
        case "_TAB": return 1;
        case "CESM": return 1;
        case "_VID": return 1;
        case "_TTA": return 1;
        case "MTAM": return 1;
        case "SGSS": return 1;
        case "LVTA": return 1;
        case "_23U": return 1;
        case "_46U": return 1;
        case "_61U": return 1;
        case "_23I": return 1;
        case "_61I": return 1;
        case "LAER": return 1;
        case "2CEV": return 1;
        case "3CEV": return 1;
        case "4CEV": return 1;
        case "TAUQ": return 1;
        case "SDNB": return 1;
        case "GALF": return 1;
        case "VEDS": return 1;
        case "V2DS": return 1;
        case "V3DS": return 1;
        case "3RDS": return 1;
        case "CCDS": return 1;
        case "8UDS": return 1;
        case "6SDS": return 1;
        case "3SDS": return 1;
        case "6UDS": return 1;
        case "3UDS": return 1;
        case "Q4DS": return 1;
        case "GFDS": return 1;
        case "BMDS": return 1;
        case "_SID": return 1;
        case "_PMC": return 1;
        case "_SMC": return 1;
        case "_ROF": return 1;
    }
    if (t.blockID == "RYAL" && t.vers <= 22) return 1;
    if (t.blockID == "_TAM" && t.vers == 15) return 1;
    if (t.blockID == "_RET" && t.vers == 0) return 1;
    if (t.blockID == "_RAP" && t.vers == 10) return 1;
    if (t.blockID == "_BIR" && (t.vers == 5 || t.vers == 6)) return 1;
    return 0;
}

void ReadTag(Tag &t)
{
    local quad ret = FTell();
    local quad section_end;
    local quad available_bytes;
    local quad expected_bytes;
    local quad payload_bytes;
    local quad parsed_bytes;
    local int entry_size;
    local int vertex_size;
    local uint safe_count;
    local uint vertex_count;
    local uint j;

    if (t.ofs >= m3_file_size)
    {
        Warning("M3 section offset is outside the file; section skipped.");
        return;
    }

    section_end = GetSectionEnd(t);
    if (section_end > m3_file_size) section_end = m3_file_size;
    if (section_end <= t.ofs) return;
    available_bytes = section_end - t.ofs;
    entry_size = GetKnownEntrySize(t);

    if (entry_size > 0)
    {
        expected_bytes = (quad)t.count * entry_size;
        safe_count = t.count;
        if (expected_bytes > available_bytes)
        {
            safe_count = (uint)(available_bytes / entry_size);
            Warning("M3 section is truncated; only complete in-file entries were parsed.");
        }
        payload_bytes = (quad)safe_count * entry_size;
    }
    else
    {
        expected_bytes = available_bytes;
        payload_bytes = available_bytes;
        safe_count = 0;
    }

    FSeek(t.ofs);
    SetBackColor(cLtGreen);

    if (t.blockID == "__8U" && current_tag_index == vertex_tag_index && flg_vert != 0)
    {
        vertex_size = GetVertexSize(flg_vert);
        payload_bytes = t.count;
        if (payload_bytes > available_bytes) payload_bytes = available_bytes;
        if (vertex_size > 0)
        {
            vertex_count = (uint)(payload_bytes / vertex_size);
            for (j = 0; j < vertex_count; j++)
                Vertex Vertices(flg_vert) <open=false>;
            parsed_bytes = (quad)vertex_count * vertex_size;
            if (parsed_bytes < payload_bytes) ByteBlock VertexTail(payload_bytes - parsed_bytes);
        }
        else if (payload_bytes > 0)
            ByteBlock VertexPayload(payload_bytes);
    }
    else if (t.blockID == "RAHC")
    {
        if (payload_bytes > 0) ByteBlock Text(payload_bytes);
    }
    else if (entry_size > 0 && IsDetailedSection(t))
    {
        switch (t.blockID)
        {
            case "LDOM":
                for (j = 0; j < safe_count; j++) MODL Models(t.vers) <open=false>;
                break;
            case "SQES":
                for (j = 0; j < safe_count; j++) SEQS Sequences(t.vers) <open=false>;
                break;
            case "_CTS": STC_ TransformationCollections[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_GTS": STG_ TransformationGroups[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_STS": STS_ TransformationSets[safe_count] <open=false, optimize=true, warn=false>; break;
            case "TNVE":
                for (j = 0; j < safe_count; j++) EVNT Events(t.vers) <open=false>;
                break;
            case "ENOB": BONE Bones[safe_count] <open=false, optimize=true, warn=false>; break;
            case "FERI": IREF BoneReferences[safe_count] <open=false, optimize=true, warn=false>; break;
            case "NGER":
                for (j = 0; j < safe_count; j++) REGN Regions(t.vers) <open=false>;
                break;
            case "_TAB": BAT_ Batches[safe_count] <open=false, optimize=true, warn=false>; break;
            case "CESM": MSEC MeshSections[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_VID": DIV_ Divisions[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_TTA": ATT_ Attachments[safe_count] <open=false, optimize=true, warn=false>; break;
            case "MTAM": MATM MaterialReferences[safe_count] <open=false, optimize=true, warn=false>; break;
            case "SGSS": SSGS HitTests[safe_count] <open=false, optimize=true, warn=false>; break;
            case "LVTA": ATVL AttachmentVolumes[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_23U": U32_ UInt32Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "_46U": uint64 UInt64Values[safe_count] <open=suppress, warn=false>; break;
            case "_61U": U16_ UInt16Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "_23I": I32_ Int32Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "_61I": I16_ Int16Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "LAER": REAL RealValues[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "2CEV": Vec2D Vector2Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "3CEV": Vec3D Vector3Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "4CEV": Vec4D Vector4Values[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "TAUQ": Vec4D QuaternionValues[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "SDNB": BNDS BoundsValues[safe_count] <open=false, optimize=true, warn=false>; break;
            case "GALF": FLAG FlagValues[safe_count] <open=suppress, optimize=true, warn=false>; break;
            case "VEDS": Animblock EventAnimations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "V2DS": Animblock Vector2Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "V3DS": Animblock Vector3Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "3RDS": Animblock RealAnimations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "CCDS": Animblock ColorAnimations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "8UDS": Animblock UInt8Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "6SDS": Animblock Int16Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "3SDS": Animblock Int32Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "6UDS": Animblock UInt16Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "3UDS": Animblock UInt32Animations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "Q4DS": Animblock QuaternionAnimations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "GFDS": Animblock FlagAnimations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "BMDS": Animblock BoundsAnimations[safe_count] <open=false, optimize=true, warn=false>; break;
            case "RYAL": LAYR MaterialLayers[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_TAM": MAT_ StandardMaterials[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_SID": DIS_ DisplacementMaterials[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_PMC": CMP_ CompositeMaterials[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_SMC": CMS_ CompositeSections[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_RET": TER_ TerrainMaterials[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_RAP": PAR_ ParticleSystems[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_BIR": RIB_ Ribbons[safe_count] <open=false, optimize=true, warn=false>; break;
            case "_ROF": FOR_ Forces[safe_count] <open=false, optimize=true, warn=false>; break;
        }
        parsed_bytes = FTell() - t.ofs;
        if (parsed_bytes != payload_bytes)
        {
            m3_layout_errors++;
            if (parsed_bytes < payload_bytes)
                ByteBlock UndecodedPayload(payload_bytes - parsed_bytes);
            else
                FSeek(t.ofs + payload_bytes);
        }
    }
    else if (payload_bytes > 0)
    {
        ByteBlock RawPayload(payload_bytes);
    }

    if (entry_size > 0 && payload_bytes < available_bytes)
    {
        FSeek(t.ofs + payload_bytes);
        ByteBlock AlignmentOrTruncatedTail(available_bytes - payload_bytes);
    }
    FSeek(ret);
}

//---------------
//----Start------
//---------------
LittleEndian();
m3_file_size = FileSize();
if (m3_file_size < 20)
{
    Warning("File is too small to contain an M3 header. Template stopped.");
    return -1;
}

local uint m3_magic = ReadUInt(0);
if (m3_magic == 0x4D443333)
    MODL_TYPE = 33;
else if (m3_magic == 0x4D443334)
    MODL_TYPE = 34;
else
{
    Warning("File is not an MD33/MD34 M3 model. Template stopped.");
    return -1;
}

Warning("Loading bounded M3 header and section index.");
FileHeader fHead <name="M3 Header", open=false>;
m3_index_offset = fHead.ofsTags;
t_offs = m3_index_offset;

if (m3_index_offset >= m3_file_size)
{
    Warning("M3 section index offset is outside the file. Template stopped.");
    return -1;
}

local quad max_tag_count = (m3_file_size - m3_index_offset) / tag_size;
m3_tag_count = fHead.nTags;
if (m3_tag_count > max_tag_count)
{
    m3_tag_count = (uint)max_tag_count;
    Warning("M3 section index is truncated; tag count was clamped to the file.");
}

FSeek(m3_index_offset);
Tag Tags[m3_tag_count] <name="Section Index", open=false>;

Warning("Loading M3 sections with schema and file-bound checks.");
struct
{
    for (i = 0; i < m3_tag_count; i++)
    {
        current_tag_index = i;
        M3SectionNode Section(Tags[i]) <open=false>;
    }
} ParsedSections <name="Parsed Sections", open=false>;
current_tag_index = -1;
if (m3_layout_errors > 0)
    Warning("One or more detailed layouts did not match their documented byte sizes; section boundaries were restored safely.");
Warning("M3 model successfully read.");
