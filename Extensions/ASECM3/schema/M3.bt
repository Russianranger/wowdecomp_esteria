typedef struct (int version)
{
    Ref model_name;
    uint32 flags <format=binary>;
    Ref sequences;
    Ref sequence_transformation_collections;
    Ref sequence_transformation_groups;
    Ref bone_anim_sets;
    uint32 split_count;
    Ref sts;
    Ref bones;
    uint32 skin_bone_count;
    uint32 vertex_flags <format=binary>;
    flg_vert = vertex_flags;
    Ref vertices;
    vertex_tag_index = vertices.HRef.indData;
    Ref divisions;
    Ref bone_lookup;
    Bounds boundings;
    Bounds collision_boundings;
    Ref collision_faces;
    Ref collision_vertices;
    Ref collision_face_normals;
    Ref attachment_points;
    Ref attachment_points_addon;
    Ref lights;
    if (version >= 21) Ref shadow_boxes;
    Ref cameras;
    Ref cameras_addon;
    Ref material_references;
    Ref materials_standard;
    Ref materials_displacement;
    Ref materials_composite;
    Ref materials_terrain;
    Ref materials_volume;
    Ref materials_hair;
    Ref materials_creep;
    if (version >= 25) Ref materials_volume_noise;
    if (version >= 26) Ref materials_splat_terrain_bake;
    if (version >= 28) Ref materials_reflection;
    if (version >= 29) Ref materials_lens_flare;
    if (version >= 30) Ref materials_buffer;
    Ref particle_systems;
    Ref particle_copies;
    Ref ribbons;
    Ref projections;
    Ref forces;
    Ref warps;
    Ref view_volumes;
    Ref physics_rigid_bodies;
    Ref physics_constraints;
    Ref physics_joints;
    if (version >= 28) Ref physics_cloths;
    Ref ik_two_joints;
    if (version >= 24) Ref ik_ccd;
    Ref ik_joints;
