//--------------------------------------
//--- 010 Editor Binary Template
//
// File: M3 Template
// Original Author: NiNtoxicated
// Modernization: OpenAI Codex, based on Solstice245/m3studio structures.xml
// Revision: 1.02 (2026-07-27)
// Purpose: Parse the Starcraft 2 Model File Format (.M3)
//
// Revision 1.00 keeps the useful 0.96 field decoders, updates the core MD34
// layouts through MODL v30, and adds bounded parsing for every section/version
// currently documented by M3Studio. Unknown data is kept as a size-aware raw
// payload instead of treating an entry count as a byte count.
// Revision 1.01 groups the results into closed header, index, and section
// branches. Each section owns a collapsible records array so large models no
// longer place thousands of records directly in the root results tree.
// Revision 1.02 makes all read-formatter scratch strings local so formatting
// Template Results never attempts to modify file-backed template variables.
//--------------------------------------

// === Global Variables ===
//Model Type
local int MODL_TYPE = 0;
local quad m3_file_size = 0;
local uint m3_index_offset = 0;
local uint m3_tag_count = 0;
local int current_tag_index = -1;
local int vertex_tag_index = -1;
local int m3_layout_errors = 0;

//Switches
const int FL_VERT = 0x08;
const int FL_ANIM = 0x09;

//Data Switches
local int flg_vert = 0;
local int flg_data = 0;

//Misc variables
local quad bm; //read in file position to return to
local uint t_offs = 0; //tag offset
local int tag_size = 16; //tag byte size
local int i = 0; //used in for loops

//Data types
//Data types that need converting
typedef ubyte fltByte <read=fltByteRead, write=fltByteWrite>;

//Read-Write funcs for Data types
string fltByteRead( fltByte b )
{
    local string s;
    local float flt = b / 255.0;  
    SPrintf( s, "%f", flt );
    return s;
}

void fltByteWrite( fltByte &b, string s )
{
    b = (fltByte)( Atof( s ) * 255.0 );
}

typedef ubyte fltNormal <read=fltNormalRead, write=fltNormalWrite>;

string fltNormalRead( fltNormal b )
{
    local string s;
    local float flt = (2.0 * b / 255.0) - 1.0;
    SPrintf( s, "%f", flt );
    return s;
}

void fltNormalWrite( fltNormal &b, string s )
{
    local float value = Atof(s);
    if (value < -1.0) value = -1.0;
    if (value >  1.0) value =  1.0;
    local int cn = (int)(((value + 1.0) * 0.5 * 255.0) + 0.5);
    b = (fltNormal)( cn );
}

typedef short uvShort <read=uvShortRead, write=uvShortWrite>;

string uvShortRead( uvShort uvs )
{
    local string s;
    // REGN v5 applies uv_multiply and uv_offset after this normalization.
    SPrintf( s, "%f", uvs / 32768.0 );
    return s;
}

void uvShortWrite( uvShort &uvs, string s )
{
    uvs = (uvShort)( Atof( s ) * 32768.0 );
}

typedef struct
{
    float x, y;
} Vec2D <read=Vec2DRead, write=Vec2DWrite>;

string Vec2DRead(Vec2D &v2d)
{
    local string s;
    SPrintf( s, "[%f, %f]", v2d.x, v2d.y);
    return s;
}

string Vec2DWrite(Vec2D &v2d, string s)
{
    SScanf( s, "[%f, %f]", v2d.x, v2d.y);
}

typedef struct
{
    float x, y, z;
} Vec3D <read=Vec3DRead,write=Vec3DWrite>;

string Vec3DRead(Vec3D &v3d)
{
    local string s;
    SPrintf( s, "[%f, %f, %f]", v3d.x, v3d.y, v3d.z);
    return s;
}

void Vec3DWrite(Vec3D &v3d, string s)
{
    SScanf( s, "[%f, %f, %f]", v3d.x, v3d.y, v3d.z);
}

typedef struct
{
    float x, y, z, w;
} Vec4D <read=Vec4DRead,write=Vec4DWrite>;

string Vec4DRead(Vec4D &q)
{
    local string s;
    SPrintf( s, "[%f, %f, %f, %f]", q.x, q.y, q.z, q.w);
    return s;
}

void Vec4DWrite( Vec4D &q, string s )
{
    SScanf( s, "[%f, %f, %f, %f]", q.x, q.y, q.z, q.w);
}

typedef struct (int type)
{
    Vec4D a, b, c, d;
    if (type == 34) { ulong flags; }
} VersionedMatrix44;

typedef struct
{
    Vec4D x, y, z, w;
} Matrix44;

typedef struct (int type)
{
    Vec3D min;
    Vec3D max;
    float radius;
    if (type == 34) { ulong flags; }
} Sphere;

typedef struct
{
    Vec3D min;
    Vec3D max;
    float radius;
} Bounds;

typedef struct (quad size)
{
    ubyte bytes[size];
} ByteBlock <open=suppress>;

// ==================
// ==  M3 STRUCTS  ==
// ==================
typedef struct
{
    ulong nData, indData;
    if (MODL_TYPE == 34)
    {
        ulong flags;
    }
} HeadRef <read=RefRead>;

string RefRead(HeadRef &r)
{
    local string s;
    SPrintf( s, "nData: %d   indData: %d", r.nData, r.indData);
    return s;
}

typedef struct
{
    char blockID[4];
    ULONG ofs;
    ULONG count; //number of entries; for byte sections this is the byte count
    ULONG vers;
} Tag <read=BlockIDRead, bgcolor=cLtPurple>;

//Function tag read declare
void ReadTag(Tag &t);
int GetKnownEntrySize(Tag &t);

string BlockIDRead(Tag &t)
{
    local string s;
    local int size = GetKnownEntrySize(t);
    if (size > 0)
        SPrintf(s, "%c%c%c%c v%d, %d x %d bytes", t.blockID[3], t.blockID[2], t.blockID[1], t.blockID[0], t.vers, t.count, size);
    else
        SPrintf(s, "%c%c%c%c v%d, %d entries (unknown version)", t.blockID[3], t.blockID[2], t.blockID[1], t.blockID[0], t.vers, t.count);
    return s;
}

typedef struct (Tag &t)
{
    local string section_name;
    local string section_summary = BlockIDRead(t);
    SPrintf(section_name, "%c%c%c%c", t.blockID[3], t.blockID[2], t.blockID[1], t.blockID[0]);
    ReadTag(t);
} M3SectionNode <name=(section_name), read=(section_summary), open=false>;

typedef struct
{
    char fType[4];
    ULONG ofsTags;
    ULONG nTags;
    HeadRef mref;
} FileHeader <bgcolor=cLtGray>; //MD33

typedef struct 
{
    HeadRef HRef;
} Ref <read=ReferenceRead>;

string ReferenceRead(Ref &r)
{
    local string s;
    if (r.HRef.nData == 0)
        SPrintf(s, "null");
    else
        SPrintf(s, "tag[%d], count %d", r.HRef.indData, r.HRef.nData);
    return s;
}

