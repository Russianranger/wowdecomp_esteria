    {
        Ref attachment_volumes_addon0;
        Ref attachment_volumes_addon1;
    }
    Ref billboards;
    Ref tmd_data;
    uint32 m3a_hash;
    Ref m3a_hashes;
} MODL <open=false, bgcolor=cAqua>;

