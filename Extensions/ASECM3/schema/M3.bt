    return s;
}

typedef struct
{
    ulong bone;
    Animref unk1;
    float f1;
    ulong d2[2];
} CMS_;

typedef struct
{
    Ref name;
    Ref diffuse;
} TER_ <read=TERRead>; // Terrain

string TERRead(TER_ &t)
{
    local string s;
    SPrintf(s, "name tag[%d]", t.name.HRef.indData);
    return s;
}

string LAYRRead(LAYR &l)
{
    local string s;
    if (l.name.HRef.nData > 1)
    {
        SPrintf(s, "texture tag[%d]", l.name.HRef.indData);
        return s;
    }
    else
    {
        s = "(No Texture)";
        return s;
    }
}

