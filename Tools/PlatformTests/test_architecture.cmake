# Exercise CMake's target-selection decisions without requiring an installed
# cross compiler. Capture definitions instead of modifying a build directory.
function(add_compile_definitions)
    set(captured_definitions "${ARGV}" PARENT_SCOPE)
endfunction()
function(check_arch generator compiler system expected)
    set(CMAKE_GENERATOR_PLATFORM "${generator}")
    set(MSVC_CXX_ARCHITECTURE_ID "${compiler}")
    set(CMAKE_SYSTEM_PROCESSOR "${system}")
    include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/TargetArchitecture.cmake")
    if (NOT captured_definitions STREQUAL "WOWDECOMP_CPU_${expected}=1")
        message(FATAL_ERROR "Wrong architecture for generator=${generator}, compiler=${compiler}, system=${system}: ${captured_definitions}")
    endif ()
endfunction()
check_arch("x64" "x64" "ARM64" "X86")
check_arch("Win32" "X86" "ARM64" "X86")
check_arch("ARM64" "ARM64" "AMD64" "ARM64")
check_arch("" "ARM64" "AMD64" "ARM64")
check_arch("" "x64" "ARM64" "X86")
check_arch("" "" "aarch64" "ARM64")
check_arch("" "" "x86_64" "X86")
check_arch("ARM64,version=10.0.22621.0" "ARM64" "AMD64" "ARM64")
message(STATUS "Cross-compilation architecture selection passed")
