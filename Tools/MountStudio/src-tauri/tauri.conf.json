{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Esteria Mount Studio",
  "version": "0.2.1",
  "identifier": "org.esteria.mountstudio",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Esteria Mount Studio", "width": 1380, "height": 900, "minWidth": 1000 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["../../../waystone.ico"],
    "windows": { "webviewInstallMode": { "type": "offlineInstaller", "silent": true } },
    "resources": {
      "../worker.py": "worker.py", "../../RetailAssets/server.py": "server.py", "../runtime/": "runtime/"
    }
  }
}
